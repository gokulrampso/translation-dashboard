{
  "info": {
    "_postman_id": "translation-manager-api",
    "name": "Translation Manager API",
    "description": "API collection for the Translation Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/../health",
              "host": ["{{baseUrl}}"],
              "path": ["..", "health"]
            },
            "description": "Check server health and cache statistics"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Languages",
      "item": [
        {
          "name": "Get Available Languages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/languages",
              "host": ["{{baseUrl}}"],
              "path": ["languages"]
            },
            "description": "Get list of languages currently in cache"
          },
          "response": []
        },
        {
          "name": "Get Supported Languages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/languages/supported",
              "host": ["{{baseUrl}}"],
              "path": ["languages", "supported"]
            },
            "description": "Get all AWS Translate supported languages"
          },
          "response": []
        },
        {
          "name": "Delete Language",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/languages/{{targetLanguage}}",
              "host": ["{{baseUrl}}"],
              "path": ["languages", "{{targetLanguage}}"]
            },
            "description": "Delete a language (cannot delete English)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Translations",
      "item": [
        {
          "name": "Get Translations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/translations/{{language}}",
              "host": ["{{baseUrl}}"],
              "path": ["translations", "{{language}}"]
            },
            "description": "Get all translations for a language (reads from cache)"
          },
          "response": []
        },
        {
          "name": "Update Translation Key",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": \"Updated value here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/translations/{{language}}/{{translationKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["translations", "{{language}}", "{{translationKey}}"]
            },
            "description": "Update a single translation key. Updates both DynamoDB and cache."
          },
          "response": []
        },
        {
          "name": "Add Translation Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"new_key\",\n  \"value\": \"New English value\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/translations/keys",
              "host": ["{{baseUrl}}"],
              "path": ["translations", "keys"]
            },
            "description": "Add a new translation key to ALL languages. Automatically translates to non-English languages."
          },
          "response": []
        },
        {
          "name": "Remove Translation Key",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/translations/keys/{{translationKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["translations", "keys", "{{translationKey}}"]
            },
            "description": "Remove a translation key from ALL languages"
          },
          "response": []
        },
        {
          "name": "Re-translate Single Key",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/translations/{{targetLanguage}}/{{translationKey}}/retranslate",
              "host": ["{{baseUrl}}"],
              "path": ["translations", "{{targetLanguage}}", "{{translationKey}}", "retranslate"]
            },
            "description": "Re-translate a single key for a non-English language"
          },
          "response": []
        },
        {
          "name": "Re-translate All Keys",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/translations/{{targetLanguage}}/retranslate",
              "host": ["{{baseUrl}}"],
              "path": ["translations", "{{targetLanguage}}", "retranslate"]
            },
            "description": "Re-translate all keys for a non-English language"
          },
          "response": []
        },
        {
          "name": "Create New Language",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetLang\": \"{{targetLanguage}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/translations/new",
              "host": ["{{baseUrl}}"],
              "path": ["translations", "new"]
            },
            "description": "Create a new language by translating all English keys"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cache",
      "item": [
        {
          "name": "Refresh Cache",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cache/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["cache", "refresh"]
            },
            "description": "Reload all languages from DynamoDB into cache"
          },
          "response": []
        },
        {
          "name": "Get Cache Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cache/status",
              "host": ["{{baseUrl}}"],
              "path": ["cache", "status"]
            },
            "description": "Get cache synchronization status including version and timestamps"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "language",
      "value": "en"
    },
    {
      "key": "targetLanguage",
      "value": "fr"
    },
    {
      "key": "translationKey",
      "value": "welcome"
    }
  ]
}

